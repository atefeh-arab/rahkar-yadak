# پورت و آدرس شنیدن سرور / Server port and bind address
PORT=3000
HOST=0.0.0.0

# رمز نشست — در اولین اجرا به‌صورت خودکار تصادفی ساخته می‌شود / Session secret (auto-generated on first run)
SESSION_SECRET=change-this-long-random-secret

# اطلاعات ورود مدیر / Default administrator credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin12345!

# اطلاعات فروشگاه / Store details
STORE_NAME=یدک‌یار
STORE_PHONE=021-55500000
STORE_ADDRESS=تهران، خیابان نمونه، پلاک ۱۲

# هزینه ارسال به تومان — ارسال رایگان از این مبلغ به بالا / Shipping cost in Toman
SHIPPING_COST=85000
FREE_SHIPPING_OVER=500000
