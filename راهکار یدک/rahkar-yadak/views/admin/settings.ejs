<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><h1>تنظیمات فروشگاه</h1><form class="panel" method="post" action="/admin/settings"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>نام فروشگاه<input required name="store_name" value="<%= settings.store_name %>"></label><label>تلفن<input required name="store_phone" value="<%= settings.store_phone %>"></label><label>نشانی<textarea name="store_address"><%= settings.store_address %></textarea></label><label>هزینه ارسال (تومان)<input type="number" min="0" name="shipping_cost" value="<%= settings.shipping_cost %>"></label><button class="btn">ذخیره تنظیمات</button></form></section></div><%- include('../partials/foot') %>