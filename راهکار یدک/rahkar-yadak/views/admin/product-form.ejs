<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><div class="adminhead"><h1><%= isNew?'افزودن محصول':'ویرایش محصول' %></h1><a href="/admin/products">بازگشت</a></div><form class="panel" method="post" enctype="multipart/form-data" action="<%= isNew?'/admin/products':'/admin/products/'+p.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="formgrid"><label class="span2">نام محصول *<input required name="name" value="<%= p.name||'' %>"></label><label>دسته‌بندی<select name="category_id"><option value="">بدون دسته</option><% categories.forEach(c=>{ %><option value="<%= c.id %>" <%= p.category_id===c.id?'selected':'' %>><%= c.name %></option><% }) %></select></label><label>برند قطعه<input name="brand" value="<%= p.brand||'' %>"></label><label>کد OEM<input name="part_number" value="<%= p.part_number||'' %>"></label><label>قیمت تومان *<input type="number" min="0" required name="price" value="<%= p.price??'' %>"></label><label>تخفیف درصدی<input type="number" min="0" max="90" name="discount" value="<%= p.discount||0 %>"></label><label>موجودی<input type="number" min="0" name="stock" value="<%= p.stock||0 %>"></label><label>برند خودرو<input name="car_brand" value="<%= p.car_brand||'' %>"></label><label>مدل خودرو<input name="car_model" value="<%= p.car_model||'' %>"></label><label>سال سازگاری<input name="year_range" value="<%= p.year_range||'' %>"></label><label>کشور سازنده<input name="origin" value="ایران"></label><label>گارانتی<input name="warranty" value="اصالت کالا"></label><label class="span2">خودروهای سازگار<input name="compatible" value="<%= p.compatible||'' %>"></label><label class="span2">توضیحات<textarea name="description" rows="4"><%= p.description||'' %></textarea></label><label class="span2">تصاویر (JPG/PNG/WebP/GIF، حداکثر ۲MB، تا ۵ فایل)<input type="file" name="images" accept="image/jpeg,image/png,image/webp,image/gif" multiple></label><% if(p.image){ %><img class="currentimg" src="<%= p.image %>" alt=""><% } %><label class="check span2"><input type="checkbox" name="featured" value="1" <%= p.featured?'checked':'' %>> محصول ویژه</label></div><button class="btn">ذخیره محصول</button></form></section></div><%- include('../partials/foot') %>