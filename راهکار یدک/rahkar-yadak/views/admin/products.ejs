<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><div class="adminhead"><h1>محصولات</h1><a class="btn" href="/admin/products/new">+ افزودن محصول</a></div><div class="panel tablewrap"><table><tr><th>نام</th><th>دسته</th><th>کد OEM</th><th>قیمت</th><th>تخفیف</th><th>موجودی</th><th>عملیات</th></tr><% products.forEach(p=>{ %><tr><td><%= p.name %></td><td><%= p.category_name||'—' %></td><td><%= p.part_number %></td><td><%= money(p.price) %></td><td><%= money(p.discount) %>٪</td><td><%= money(p.stock) %></td><td><a href="/admin/products/<%= p.id %>/edit">ویرایش</a> <form class="inline" method="post" action="/admin/products/<%= p.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="textbtn" onclick="return confirm('حذف شود؟')">حذف</button></form></td></tr><% }) %></table></div></section></div><%- include('../partials/foot') %>