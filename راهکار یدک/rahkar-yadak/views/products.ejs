<%- include('partials/head',{title,categories}) %><div class="crumb"><a href="/">خانه</a> / قطعات خودرو</div><div class="listing"><aside class="filters"><h2>فیلتر محصولات</h2><form action="/products" method="get"><input type="hidden" name="q" value="<%= query.q||'' %>"><label>دسته‌بندی</label><select name="category"><option value="">همه دسته‌ها</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>" <%= query.category===c.slug?'selected':'' %>><%= c.name %></option><% }) %></select><label>برند خودرو</label><select name="car_brand"><option value="">همه برندها</option><% carBrands.forEach(b=>{ %><option <%= query.car_brand===b.name?'selected':'' %>><%= b.name %></option><% }) %></select><label>مدل خودرو</label><input name="car_model" value="<%= query.car_model||'' %>" placeholder="مثلاً ۲۰۶ یا سورن"><label>برند قطعه</label><input name="part_brand" value="<%= query.part_brand||'' %>" placeholder="نام برند"><label>حداقل قیمت (تومان)</label><input type="number" min="0" name="min_price" value="<%= query.min_price||'' %>"><label>حداکثر قیمت (تومان)</label><input type="number" min="0" name="max_price" value="<%= query.max_price||'' %>"><label class="check"><input type="checkbox" name="available" value="1" <%= query.available==='1'?'checked':'' %>> فقط موجودها</label><label>مرتب‌سازی</label><select name="sort"><option value="newest">جدیدترین</option><option value="cheapest" <%= query.sort==='cheapest'?'selected':'' %>>ارزان‌ترین</option><option value="expensive" <%= query.sort==='expensive'?'selected':'' %>>گران‌ترین</option><option value="bestselling" <%= query.sort==='bestselling'?'selected':'' %>>پرفروش‌ترین</option></select><button class="btn wide">اعمال فیلتر</button><a class="reset" href="/products">پاک کردن فیلترها</a></form></aside><section class="results"><div class="sectionhead"><div><h1><%= query.q?'نتایج جست‌وجو: '+query.q:'قطعات خودرو' %></h1><small><%= money(total) %> محصول</small></div></div><% if(!products.length){ %><div class="empty"><h2>محصولی پیدا نشد</h2><p>فیلترها را تغییر دهید یا عبارت دیگری جست‌وجو کنید.</p><a class="btn" href="/products">همه محصولات</a></div><% }else{ %><div class="grid"><% products.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div><% } %><% if(pages>1){ %><div class="pagination"><% for(let i=1;i<=pages;i++){ %><a class="<%= page===i?'active':'' %>" href="?<%= new URLSearchParams({...query,page:i}).toString() %>"><%= money(i) %></a><% } %></div><% } %></section></div><%- include('partials/foot') %>