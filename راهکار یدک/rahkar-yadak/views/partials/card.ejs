<article class="card"><a class="thumb" href="/product/<%= p.id %>"><img loading="lazy" src="<%= p.image||'/images/part.svg' %>" alt="<%= p.name %>"><% if(p.discount){ %><span class="badge"><%= money(p.discount) %>٪</span><% } %></a><div class="cardbody"><small class="muted"><%= p.category_name||'قطعات خودرو' %></small><a class="ptitle" href="/product/<%= p.id %>"><%= p.name %></a><small class="muted"><%= p.brand||'متفرقه' %> · <%= p.part_number||'—' %></small><div class="price"><div><% if(p.discount){ %><del><%= money(p.price) %></del><% } %><b><%= money(Math.round(p.price*(100-p.discount)/100)) %></b><small>تومان</small></div><span class="<%= p.stock?'available':'unavailable' %>"><%= p.stock?'موجود':'ناموجود' %></span></div><form method="post" action="/cart/add"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= p.id %>"><button class="add" <%= p.stock?'':'disabled' %>>افزودن به سبد</button></form></div></article>