<%- include('partials/head',{title,categories:[]}) %><div class="crumb"><a href="/">خانه</a> / <a href="/products">محصولات</a> / <%= p.name %></div><div class="detail"><div class="detailimg"><img src="<%= p.image %>" alt="<%= p.name %>"></div><div><small class="muted"><%= p.category_name||'قطعات خودرو' %></small><h1><%= p.name %></h1><p class="muted">برند: <b><%= p.brand||'متفرقه' %></b> · کد OEM: <b><%= p.part_number||'—' %></b></p><div class="bigprice"><% if(p.discount){ %><del><%= money(p.price) %> تومان</del><% } %><b><%= money(Math.round(p.price*(100-p.discount)/100)) %></b> تومان</div><p class="<%= p.stock?'available':'unavailable' %>"><%= p.stock?'موجود در انبار ('+money(p.stock)+' عدد)':'ناموجود' %></p><p><%= p.description %></p><form method="post" action="/cart/add" class="addform"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= p.id %>"><label>تعداد <input type="number" name="qty" min="1" max="<%= Math.max(1,p.stock) %>" value="1"></label><button class="btn" <%= p.stock?'':'disabled' %>>افزودن به سبد خرید</button></form><div class="compat"><h3>خودروهای سازگار</h3><p><%= p.compatible||'کد OEM را با قطعه فعلی تطبیق دهید.' %></p><p>برند: <%= p.car_brand||'—' %> · مدل: <%= p.car_model||'—' %> · سال: <%= p.year_range||'—' %></p></div></div></div><section class="section"><h2>مشخصات فنی</h2><table><tr><th>برند قطعه</th><td><%= p.brand %></td></tr><tr><th>کد OEM</th><td><%= p.part_number %></td></tr><% Object.entries(specs).forEach(([k,v])=>{ %><tr><th><%= k %></th><td><%= v %></td></tr><% }) %></table><h2>توضیحات</h2><p><%= p.description %></p></section><% if(related.length){ %><section class="section"><h2>محصولات مرتبط</h2><div class="grid"><% related.forEach(p=>{ %><%- include('partials/card',{p}) %><% }) %></div></section><% } %><%- include('partials/foot') %>