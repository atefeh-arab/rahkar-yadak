<%- include('partials/head',{title,categories:[]}) %><h1 class="pagetitle">سبد خرید</h1><% if(!items.length){ %><div class="empty"><h2>سبد خرید شما خالی است</h2><a class="btn" href="/products">رفتن به فروشگاه</a></div><% }else{ %><div class="cartlayout"><div class="panel"><% items.forEach(i=>{ %><div class="cartitem"><img src="<%= i.image %>" alt=""><div class="grow"><a href="/product/<%= i.id %>"><b><%= i.name %></b></a><small><%= i.brand %> · <%= i.part_number %></small><b><%= money(i.lineTotal) %> تومان</b><form class="inline" method="post" action="/cart/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= i.id %>"><input type="number" name="qty" min="0" max="<%= i.stock %>" value="<%= i.qty %>"><button class="btn small">به‌روزرسانی</button></form><form method="post" action="/cart/remove"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="product_id" value="<%= i.id %>"><button class="textbtn">حذف</button></form></div></div><% }) %></div><aside class="panel summary"><h2>خلاصه سفارش</h2><div><span>جمع کالاها</span><b><%= money(subtotal) %> تومان</b></div><div><span>هزینه ارسال</span><span>در مرحله بعد</span></div><hr><a class="btn wide" href="/checkout">ادامه و ثبت سفارش</a><a class="reset" href="/products">ادامه خرید</a></aside></div><% } %><%- include('partials/foot') %>