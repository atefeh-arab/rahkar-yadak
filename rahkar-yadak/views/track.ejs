<%- include('partials/head',{title,categories:[]}) %><div class="auth"><h1>پیگیری سفارش</h1><form method="post" action="/track"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>کد پیگیری<input required name="tracking_code" placeholder="RY-..."></label><button class="btn wide">بررسی وضعیت</button></form><% if(order){ %><p><b><%= order.tracking_code %></b></p><p>وضعیت: <%= ({pending:'در انتظار تأیید',processing:'در حال پردازش',shipped:'ارسال شده',delivered:'تحویل شده',cancelled:'لغو شده'})[order.status] %></p><small><%= faDate(order.created_at) %></small><% }else if(order===false){ %><p>سفارشی با این کد پیدا نشد.</p><% } %></div><%- include('partials/foot') %>