<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><h1>دسته‌ها و خودروها</h1><div class="twocol"><div class="panel"><h2>دسته‌بندی‌ها</h2><form class="inline" method="post" action="/admin/categories"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input required name="name" placeholder="نام دسته"><button class="btn">افزودن</button></form><% categories.forEach(c=>{ %><div class="listrow"><span><%= c.name %> (<%= money(c.product_count) %>)</span><form method="post" action="/admin/categories/<%= c.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="textbtn">حذف</button></form></div><% }) %></div><div class="panel"><h2>برند خودرو</h2><form class="inline" method="post" action="/admin/car-brands"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input required name="name" placeholder="نام برند"><button class="btn">افزودن</button></form><% brands.forEach(b=>{ %><div class="listrow"><span><%= b.name %></span><form method="post" action="/admin/car-brands/<%= b.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="textbtn">حذف</button></form></div><% }) %><h2>مدل خودرو</h2><form class="inline" method="post" action="/admin/car-models"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="brand_id"><% brands.forEach(b=>{ %><option value="<%= b.id %>"><%= b.name %></option><% }) %></select><input required name="name" placeholder="مدل"><button class="btn">افزودن</button></form><% models.forEach(m=>{ %><div class="listrow"><%= m.brand_name %> — <%= m.name %></div><% }) %></div></div></section></div><%- include('../partials/foot') %>