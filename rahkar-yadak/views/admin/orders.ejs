<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><h1>سفارش‌ها</h1><div class="panel tablewrap"><table><tr><th>کد</th><th>گیرنده</th><th>تلفن</th><th>مبلغ</th><th>پرداخت</th><th>وضعیت</th><th>تاریخ شمسی</th><th></th></tr><% orders.forEach(o=>{ %><tr><td><%= o.tracking_code %></td><td><%= o.recipient %></td><td><%= o.phone %></td><td><%= money(o.total) %></td><td><%= o.payment_method %></td><td><%= o.status %></td><td><%= faDate(o.created_at) %></td><td><a href="/admin/orders/<%= o.id %>">جزئیات</a></td></tr><% }) %></table></div></section></div><%- include('../partials/foot') %>