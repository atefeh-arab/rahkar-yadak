<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><h1>سفارش <%= order.tracking_code %></h1><div class="twocol"><div class="panel"><h2>اقلام سفارش</h2><% items.forEach(i=>{ %><p><%= i.name %> × <%= money(i.quantity) %> — <%= money(i.price*i.quantity) %> تومان</p><% }) %><hr><b>مبلغ کل: <%= money(order.total) %></b></div><div class="panel"><h2>ارسال به</h2><p><%= order.recipient %> · <%= order.phone %></p><p><%= order.province %>، <%= order.city %>، <%= order.address %></p><form method="post" action="/admin/orders/<%= order.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>وضعیت<select name="status"><% [['pending','در انتظار'],['processing','در حال پردازش'],['shipped','ارسال شده'],['delivered','تحویل شده'],['cancelled','لغو شده']].forEach(s=>{ %><option value="<%= s[0] %>" <%= order.status===s[0]?'selected':'' %>><%= s[1] %></option><% }) %></select></label><button class="btn">ذخیره وضعیت</button></form></div></div></section></div><%- include('../partials/foot') %>