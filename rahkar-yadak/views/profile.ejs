<%- include('partials/head',{title,categories:[]}) %><h1 class="pagetitle">حساب کاربری</h1><div class="profilehead"><div><h2>سلام، <%= user.name %></h2><%= user.email %></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn outline">خروج</button></form></div><div class="profilegrid"><section class="panel"><h2>افزودن نشانی</h2><form method="post" action="/profile/address" class="formgrid"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>عنوان<input name="title" value="خانه"></label><label>نام گیرنده<input required name="recipient"></label><label>تلفن<input required name="phone"></label><label>استان<input required name="province"></label><label>شهر<input required name="city"></label><label>کد پستی<input name="postal_code"></label><label class="span2">نشانی<textarea required name="address"></textarea></label><button class="btn">ذخیره نشانی</button></form><h3>نشانی‌های ذخیره‌شده</h3><% addresses.forEach(a=>{ %><p><b><%= a.title %> · <%= a.recipient %></b><br><%= a.province %>، <%= a.city %>، <%= a.address %><form method="post" action="/profile/address/<%= a.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="textbtn">حذف نشانی</button></form></p><% }) %></section><section class="panel"><h2>سفارش‌های اخیر</h2><% orders.forEach(o=>{ %><div class="orderrow"><b><%= o.tracking_code %></b><span><%= ({pending:'در انتظار',processing:'پردازش',shipped:'ارسال',delivered:'تحویل',cancelled:'لغو'})[o.status] %></span><b><%= money(o.total) %> تومان</b><a href="/order/<%= o.id %>">جزئیات</a></div><% }) %></section></div><%- include('partials/foot') %>