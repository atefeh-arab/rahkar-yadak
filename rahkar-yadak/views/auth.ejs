<%- include('partials/head',{title,categories:[]}) %><div class="auth"><h1><%= mode==='register'?'ساخت حساب کاربری':'ورود به حساب کاربری' %></h1><form method="post" action="<%= mode==='register'?'/register':'/login' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(mode==='register'){ %><label>نام و نام خانوادگی<input required name="name" minlength="2"></label><label>شماره موبایل<input required name="phone" minlength="7"></label><% } %><label>ایمیل<input required type="email" name="email"></label><label>رمز عبور<input required type="password" name="password" minlength="<%= mode==='register'?8:1 %>"></label><button class="btn wide"><%= mode==='register'?'ثبت‌نام':'ورود' %></button></form><p><a href="<%= mode==='register'?'/login':'/register' %>"><%= mode==='register'?'ورود به حساب':'ساخت حساب جدید' %></a></p></div><%- include('partials/foot') %>