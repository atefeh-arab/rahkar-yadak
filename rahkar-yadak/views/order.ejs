<%- include('partials/head',{title,categories:[]}) %><div class="empty"><h1>سفارش شما ثبت شد</h1><p>کد پیگیری</p><h2 class="red"><%= order.tracking_code %></h2><p>وضعیت: <%= ({pending:'در انتظار تأیید',processing:'در حال پردازش',shipped:'ارسال شده',delivered:'تحویل شده',cancelled:'لغو شده'})[order.status] %></p><p>پرداخت: <%= order.payment_method==='demo'?(order.payment_status==='paid-demo'?'پرداخت آزمایشی ثبت شد':'در انتظار پرداخت آزمایشی'):'پرداخت در محل' %></p><div class="panel"><% items.forEach(i=>{ %><p><%= i.name %> × <%= money(i.quantity) %> — <%= money(i.price*i.quantity) %> تومان</p><% }) %><hr><b>مبلغ کل: <%= money(order.total) %> تومان</b><p><%= order.recipient %> · <%= order.phone %></p><p><%= order.province %>، <%= order.city %>، <%= order.address %></p></div><a class="btn" href="/profile">حساب کاربری</a></div><%- include('partials/foot') %>