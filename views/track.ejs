<%- include('partials/head') %>

<div class="auth-wrap" style="max-width:560px">
  <h1>پیگیری سفارش</h1>
  <p class="muted">کد رهگیری سفارش را که هنگام ثبت دریافت کرده‌اید وارد کنید.</p>

  <form action="/track" method="get">
    <div class="field">
      <label>کد رهگیری</label>
      <input type="text" name="code" dir="ltr" value="<%= code || '' %>" placeholder="RY1A2B3C" required
             style="text-transform:uppercase;letter-spacing:1px">
    </div>
    <button class="btn btn-block" type="submit">پیگیری</button>
  </form>

  <% if (code && !order) { %>
    <div class="alert alert-err" style="margin-top:14px">سفارشی با این کد پیدا نشد. کد را بررسی کنید.</div>
  <% } %>

  <% if (order) { %>
    <div style="margin-top:18px;border-top:1px dashed var(--line);padding-top:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap">
        <strong dir="ltr"><%= order.code %></strong>
        <span class="status st-<%= order.status %>">
          <%= order.status === 'pending' ? 'در انتظار پرداخت' : order.status === 'processing' ? 'در حال پردازش' : order.status === 'shipped' ? 'ارسال شده' : order.status === 'delivered' ? 'تحویل شده' : 'لغو شده' %>
        </span>
      </div>
      <p class="muted" style="font-size:13px;margin:6px 0">ثبت‌شده در <%= dateTimeFa(order.created_at) %> — گیرنده: <%= order.receiver %></p>
      <ul style="font-size:13.5px">
        <% order.items.forEach(function (it) { %><li>• <%= it.name %> × <%= fa(it.qty) %></li><% }) %>
      </ul>
      <p><strong>مبلغ کل:</strong> <span class="red"><%= money(order.total) %> تومان</span></p>

      <div style="display:flex;gap:6px;margin-top:10px">
        <% ['pending','processing','shipped','delivered'].forEach(function (s, i) { %>
          <span style="flex:1;text-align:center;font-size:11.5px;padding:6px 2px;border-radius:8px;
            background:<%= ['pending','processing','shipped','delivered'].indexOf(order.status) >= i ? 'var(--red)' : '#eee' %>;
            color:<%= ['pending','processing','shipped','delivered'].indexOf(order.status) >= i ? '#fff' : '#888' %>">
            <%= ['ثبت سفارش','پردازش','ارسال','تحویل'][i] %>
          </span>
        <% }) %>
      </div>
    </div>
  <% } %>
</div>

<%- include('partials/foot') %>
