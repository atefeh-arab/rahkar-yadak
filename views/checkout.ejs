<%- include('partials/head',{title,categories:[]}) %><h1 class="pagetitle">تکمیل سفارش</h1><form method="post" action="/checkout" class="cartlayout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><section class="panel"><h2>اطلاعات ارسال</h2><div class="formgrid"><label>نام گیرنده<input required name="recipient"></label><label>شماره تماس<input required name="phone"></label><label>استان<input required name="province"></label><label>شهر<input required name="city"></label><label>کد پستی<input name="postal_code"></label><label class="span2">نشانی کامل<textarea required name="address"></textarea></label><label class="span2">توضیحات<textarea name="note"></textarea></label></div><h2>روش پرداخت</h2><label><input type="radio" name="payment_method" value="cod" checked> پرداخت در محل</label><label><input type="radio" name="payment_method" value="demo"> پرداخت اینترنتی (درگاه آزمایشی؛ بدون تراکنش واقعی)</label></section><aside class="panel summary"><h2>خلاصه سفارش</h2><% items.forEach(i=>{ %><div><span><%= i.name %> × <%= money(i.qty) %></span><b><%= money(i.lineTotal) %></b></div><% }) %><hr><div><span>جمع کالاها</span><b><%= money(subtotal) %></b></div><div><span>ارسال</span><b><%= money(shippingCost) %></b></div><h3><%= money(subtotal+shippingCost) %> تومان</h3><button class="btn wide">ثبت سفارش</button></aside></form><%- include('partials/foot') %>