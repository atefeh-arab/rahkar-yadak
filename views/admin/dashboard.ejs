<%- include('../partials/head',{title,categories:[]}) %><div class="adminlayout"><%- include('nav') %><section><div class="adminhead"><div><h1>داشبورد</h1><small><%= faDate(new Date()) %></small></div><a class="btn" href="/admin/products/new">+ افزودن محصول</a></div><div class="stats"><div>کل سفارش‌ها<strong><%= money(totalOrders) %></strong></div><div>فروش امروز<strong><%= money(today) %> تومان</strong></div><div>کل محصولات<strong><%= money(totalProducts) %></strong></div><div>هشدار موجودی<strong><%= money(lowStock.length) %></strong></div></div><div class="panel"><h2>سفارش‌های اخیر</h2><div class="tablewrap"><table><tr><th>کد پیگیری</th><th>گیرنده</th><th>مبلغ</th><th>وضعیت</th><th>تاریخ شمسی</th><th></th></tr><% latest.forEach(o=>{ %><tr><td><%= o.tracking_code %></td><td><%= o.recipient %></td><td><%= money(o.total) %></td><td><%= o.status %></td><td><%= faDate(o.created_at) %></td><td><a href="/admin/orders/<%= o.id %>">جزئیات</a></td></tr><% }) %></table></div></div><div class="panel"><h2>کمبود موجودی</h2><% lowStock.forEach(p=>{ %><p><%= p.name %> — موجودی: <%= money(p.stock) %> <a href="/admin/products/<%= p.id %>/edit">ویرایش</a></p><% }) %></div></section></div><%- include('../partials/foot') %>