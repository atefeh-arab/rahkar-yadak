<%- include('_top') %>

<div class="admin-title"><h1>مشتریان <span class="muted" style="font-size:13px">(<%= fa(rows.length) %> نفر)</span></h1></div>

<div class="box">
  <% if (!rows.length) { %>
    <p class="muted">هنوز مشتری‌ای ثبت‌نام نکرده است.</p>
  <% } else { %>
  <table class="table">
    <thead><tr><th>نام</th><th>ایمیل</th><th>موبایل</th><th>تاریخ عضویت</th><th>تعداد سفارش</th><th>مجموع خرید</th></tr></thead>
    <tbody>
      <% rows.forEach(function (u) { %>
        <tr>
          <td><strong><%= u.name %></strong></td>
          <td dir="ltr"><small><%= u.email %></small></td>
          <td dir="ltr"><%= u.phone || '—' %></td>
          <td><%= dateFa(u.created_at) %></td>
          <td><%= fa(u.orders) %></td>
          <td><%= money(u.spent) %> تومان</td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<%- include('_bottom') %>
