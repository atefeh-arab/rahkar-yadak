<%- include('_top') %>

<div class="admin-title"><h1>دسته‌بندی‌ها</h1></div>

<div class="box">
  <h3>افزودن دسته‌بندی جدید</h3>
  <form action="/admin/categories" method="post" style="display:flex;gap:8px;flex-wrap:wrap">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input class="input" style="max-width:320px" type="text" name="name" required minlength="2" placeholder="مثلاً: سیستم تعلیق">
    <button class="btn" type="submit">افزودن</button>
  </form>
</div>

<div class="box">
  <h3>فهرست دسته‌بندی‌ها</h3>
  <% if (!rows.length) { %><p class="muted">دسته‌بندی‌ای وجود ندارد.</p><% } else { %>
  <table class="table">
    <thead><tr><th>نام</th><th>اسلاگ</th><th>تعداد کالا</th><th></th></tr></thead>
    <tbody>
      <% rows.forEach(function (c) { %>
        <tr>
          <form action="/admin/categories/<%= c.id %>" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <td><input class="input" type="text" name="name" value="<%= c.name %>" required></td>
            <td dir="ltr"><small><%= c.slug %></small></td>
            <td><%= fa(c.n) %></td>
            <td>
              <div class="acts">
                <button class="btn btn-sm btn-ghost" type="submit">ذخیره</button>
              </div>
            </td>
          </form>
          <td>
            <div class="acts">
              <a class="btn btn-sm btn-outline" href="/products?cat=<%= c.slug %>" target="_blank" rel="noopener">مشاهده در سایت</a>
              <form action="/admin/categories/<%= c.id %>/delete" method="post" data-confirm="دسته‌بندی «<%= c.name %>» حذف شود؟ کالاهای آن بدون دسته می‌مانند.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit">حذف</button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% } %>
</div>

<%- include('_bottom') %>
