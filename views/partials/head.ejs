<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> | <%= storeName %></title><link rel="icon" href="/images/favicon.svg"><link rel="stylesheet" href="/public/css/style.css"><script defer src="/public/js/store.js"></script></head><body><div class="topbar"><div class="container"><span>ارسال مطمئن قطعات خودرو</span><span>پشتیبانی: <%= storePhone %></span><a href="/track">پیگیری سفارش</a></div></div><header class="container header"><a class="brand" href="/"><img src="/images/logo.svg" alt=""><span><b><%= storeName %></b><small>همراه مطمئن خودروی شما</small></span></a><form class="search" action="/products"><input id="site-search" name="q" value="<%= typeof query!=='undefined'&&query.q?query.q:'' %>" placeholder="نام قطعه، کد فنی یا برند را جست‌وجو کنید" autocomplete="off"><button>جست‌وجو</button><div id="suggestions" class="suggestions"></div></form><div class="actions"><a href="/cart">سبد خرید <i><%= cartCount %></i></a><% if(user){ %><a href="/profile">حساب من</a><% }else{ %><a href="/login">ورود / ثبت‌نام</a><% } %></div></header><nav class="nav"><div class="container"><a href="/products">همه قطعات</a><% (typeof categories!=='undefined'?categories:[]).slice(0,10).forEach(c=>{ %><a href="/category/<%= c.slug %>"><%= c.name %></a><% }) %><% if(user&&user.role==='admin'){ %><a href="/admin">مدیریت</a><% } %></div></nav><main class="container main"><% if(flash){ %><div class="flash <%= flash.type %>"><%= flash.text %></div><% } %>