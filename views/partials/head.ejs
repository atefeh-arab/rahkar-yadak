<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | <%= storeName %></title>
<meta name="description" content="فروشگاه اینترنتی قطعات یدکی خودرو — فیلتر بر اساس برند، مدل و سال خودرو">
<link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="topbar">
  <div class="container">
    <span>ارسال به سراسر کشور &bull; ضمانت اصالت کالا &bull; پرداخت در محل</span>
    <span class="hide-sm">تلفن پشتیبانی: <%= storePhone %></span>
  </div>
</div>

<header class="header">
  <div class="container">
    <a class="logo" href="/"><img src="/images/logo.svg" alt="<%= storeName %>"></a>

    <div class="search">
      <form action="/search" method="get" role="search">
        <input id="search-box" type="search" name="q" autocomplete="off"
               placeholder="جست‌وجوی قطعه، کد فنی (OEM) یا برند..."
               value="<%= (query && query.q) ? query.q : '' %>">
        <button type="submit">جست‌وجو</button>
      </form>
      <div class="suggest" id="suggest"></div>
    </div>

    <div class="head-actions">
      <% if (user) { %>
        <a class="head-btn" href="/account"><span class="lbl"><%= user.name.split(' ')[0] %></span> 👤</a>
        <a class="head-btn" href="/orders"><span class="lbl">سفارش‌ها</span> 📦</a>
      <% } else { %>
        <a class="head-btn" href="/login"><span class="lbl">ورود / ثبت‌نام</span> 👤</a>
      <% } %>
      <a class="head-btn" href="/cart"><span class="lbl">سبد خرید</span> 🛒
        <span class="cart-badge"><%= fa(cartCount) %></span>
      </a>
    </div>
  </div>
</header>

<nav class="nav">
  <div class="container">
    <a href="/products" <%= path === '/products' && !query.cat ? 'class="active"' : '' %>>همه کالاها</a>
    <% navCategories.forEach(function (c) { %>
      <a href="/products?cat=<%= c.slug %>"><%= c.name %></a>
    <% }) %>
    <a href="/track">پیگیری سفارش</a>
  </div>
</nav>

<% if (flash) { %>
  <div class="container" style="margin-top:14px">
    <div class="alert <%= flash.type === 'ok' ? 'alert-ok' : 'alert-err' %>" data-autohide><%= flash.text %></div>
  </div>
<% } %>

<main class="container" style="padding-top:16px;padding-bottom:20px">
